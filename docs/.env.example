# Base URL used for metadata and canonical links (defaults to https://docs.discord-enterprise.com).
# NEXT_PUBLIC_APP_URL=https://docs.discord-enterprise.com

# --- Discord Enterprise Traffic Manager instrumentation --------------------------------
# Both values come from Discord Enterprise: Dashboard > Website > Traffic > Platforms &
# sources > Install, on the property that represents this site. Without them the
# instrumentation is not loaded at all and no audience data is collected.
# NEXT_PUBLIC_DISCORD_ENTERPRISE_TRAFFIC_ENDPOINT=https://<discord-enterprise-host>
# NEXT_PUBLIC_DISCORD_ENTERPRISE_TRAFFIC_KEY=pk_...
