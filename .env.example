# Discord Enterprise — environment template for the root Compose stack.
#
#   cp .env.example .env
#
# This repository deploys exactly one service: the community bot. There is no
# PostgreSQL, Redis, API, dashboard, OAuth provider or Compose profile, so none
# of those variables belong here.
#
# `.env` is the single source of configuration: Compose reads it for
# interpolation and bot/config/env.js loads it when the process environment is
# incomplete. If `.env` is absent, the bot falls back to this template for its
# defaults. Never commit `.env`. The only secrets here are DISCORD_TOKEN and,
# when event delivery is enabled, DISCORD_ENTERPRISE_EVENT_SECRET.

# ── Image / build (Compose interpolation) ───────────────────────────────────
# Plain `docker compose up --build` uses these values. The Makefile supplies
# its own image and version for `make docker-up` / `make docker-build`.
DISCORD_ENTERPRISE_VERSION=2.0.0
DISCORD_ENTERPRISE_BOT_IMAGE=ghcr.io/skygenesisenterprise/discord-enterprise
DISCORD_ENTERPRISE_BOT_VERSION=latest

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production

# REQUIRED. Bot token and application id from the Discord Developer Portal.
# Bot-scoped alternatives exist when several bots share one environment:
#   DISCORD_ENTERPRISE_DISCORD_ENTERPRISE_DISCORD_TOKEN
#   DISCORD_ENTERPRISE_DISCORD_ENTERPRISE_DISCORD_APPLICATION_ID
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# debug | info | warn | error (`silent` is rejected by this bot).
DISCORD_ENTERPRISE_LOG_LEVEL=info

# global | guild | none. For `guild`, set DISCORD_ENTERPRISE_COMMAND_GUILD_ID.
DISCORD_ENTERPRISE_COMMAND_SCOPE=global
DISCORD_ENTERPRISE_COMMAND_GUILD_ID=

# Legacy variable still forwarded by Compose; the bot reads
# DISCORD_ENTERPRISE_COMMAND_GUILD_ID above for guild-scoped deployment.
# DISCORD_GUILD_ID=

# Deploy slash commands once at startup (idempotent). Alternatively run
# `node deploy-commands.js` from bot/ once its dependencies are installed.
DISCORD_ENTERPRISE_DEPLOY_COMMANDS=false

# Permission bitmask embedded in /invite (2048 = Send Messages).
DISCORD_ENTERPRISE_INVITE_PERMISSIONS=2048

# ── Health and public links ─────────────────────────────────────────────────
# Compose publishes this port on the host. The bot serves /healthz, /livez and
# /metrics on it; the container healthcheck probes /healthz.
DISCORD_ENTERPRISE_HEALTH_PORT=3010
DISCORD_ENTERPRISE_DOCS_URL=https://docs.discord-enterprise.com
DISCORD_ENTERPRISE_SUPPORT_URL=https://github.com/SkyGenesisEnterprise/discord-enterprise/issues

# ── Data (SQLite) ───────────────────────────────────────────────────────────
# Compose fixes these paths in the container and mounts the named volume
# discord-enterprise-data at /app/bot/data. They matter only when the bot is
# run directly from bot/ with the root .env in place.
# DISCORD_ENTERPRISE_DATA_DIR=/app/bot/data
# DISCORD_ENTERPRISE_DATABASE_PATH=/app/bot/data/discord-enterprise.sqlite3

# ── Optional event delivery ─────────────────────────────────────────────────
# An empty URL disables delivery. The secret is the HMAC key shared with the
# event consumer; generate it with `openssl rand -hex 32`.
DISCORD_ENTERPRISE_EVENT_URL=
DISCORD_ENTERPRISE_EVENT_SECRET=
DISCORD_ENTERPRISE_EVENT_SOURCE=
