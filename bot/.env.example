# Discord Enterprise — copy to bot/.env, then fill in the credentials.
# Standalone: docker compose up -d --build
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

NODE_ENV=production
DISCORD_ENTERPRISE_LOG_LEVEL=info
DISCORD_ENTERPRISE_HEALTH_PORT=3010
DISCORD_ENTERPRISE_DATA_DIR=./data
DISCORD_ENTERPRISE_DATABASE_PATH=./data/discord-enterprise.sqlite3
DISCORD_ENTERPRISE_DEPLOY_COMMANDS=false

DISCORD_ENTERPRISE_DOCS_URL=https://docs.discord-enterprise.com
DISCORD_ENTERPRISE_SUPPORT_URL=https://github.com/SkyGenesisEnterprise/discord-enterprise/issues
